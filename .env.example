# ChanAnalyzer 环境变量配置模板
# 复制此文件为 .env 并填入你的实际值

# ==================== 必需配置 ====================

# Tushare API Token
# 获取地址: https://tushare.pro/register
# 用途: A股行情数据获取
TUSHARE_TOKEN=your_tushare_token_here

# ==================== 管理员账号(首次启动自动创建) ====================
# 密码生产环境务必用强随机串;改密码重启服务即生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here
# ADMIN_EMAIL=you@example.com  (可选,注册审核提醒收件人)

# ==================== AI 服务配置（按需选择） ====================

# --- DeepSeek（推荐，默认） ---
# 获取地址: https://platform.deepseek.com/api_keys
# 用途: AI 智能分析（分析师 + 决策者）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 硅基流动（备选） ---
# 获取地址: https://cloud.siliconflow.cn/account/ak
# 用途: 通过硅基流动调用 DeepSeek/Qwen 等模型
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ==================== 可选配置 ====================

# 数据库连接字符串 (默认: sqlite:///./chan.db)
# DATABASE_URL=sqlite:///./chan.db

# JWT 密钥 (默认: chanalyzer-secret-key-change-in-production,公开字符串)
# 生产环境必须换: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET_KEY=your-random-secret-key

# token 有效期小时数 (默认: 24)
# 建议 168(7天): 配合前端每12h自动续期,页面长期开着不掉线,7天内重开免登录
# JWT_EXPIRE_HOURS=168

# 最大并发扫描数 (默认: 5)
# MAX_CONCURRENT_SCANS=5

# 普通用户每日 AI 分析次数上限 (默认: 5, admin 不限量)
# AI_DAILY_LIMIT=5

# 新用户注册时给管理员发审核提醒邮件 (需配置 ADMIN_EMAIL)
# REGISTER_NOTIFY_EMAIL=true

# 服务端口 (默认: 8000)
# PORT=8000

# ==================== 邮件配置 (验证码/注册通知) ====================
# 阿里云邮件推送 DirectMail 或其他支持 SSL 的 SMTP 服务
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=缠论分析

# ==================== 云平台配置 (自动检测) ====================
# RENDER=true
# RAILWAY=true

# ==================== 加密货币(可选) ====================
# K线数据源: binance=公开行情镜像(默认,大陆可直连,免代理,免key)
#            okx=OKX 官方API(大陆需代理,见下方 OKX_PROXY)
# CRYPTO_SOURCE=binance
# 镜像域名(默认 https://data-api.binance.vision;不可达时可配置备用)
# BINANCE_BASE_URL=https://data-api.binance.vision
# OKX 源专用: 代理(大陆不可直连;CRYPTO_SOURCE=binance 时不生效)
OKX_PROXY=http://127.0.0.1:7897
# 海外服务器 OKX 直连: OKX_PROXY=none
# OKX API 域名(默认 https://www.okx.com;主域名 DNS 被污染时可尝试切换线路)
# OKX_BASE_URL=https://www.okx.com
# 白名单(逗号分隔,只允许这些产品入库;不配置则用内置前20主流;旧名 OKX_SYMBOLS 仍兼容)
# BINANCE_SYMBOLS=BTC-USDT,ETH-USDT,SOL-USDT
# 币功能总开关: 1=对所有用户开放;留空/0=仅管理员可用(默认,保守)
# ENABLE_CRYPTO=1
