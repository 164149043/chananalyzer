# ChanAnalyzer 环境变量配置模板
# 复制此文件为 .env 并填入你的实际值

# ==================== 必需配置 ====================

# Tushare API Token
# 获取地址: https://tushare.pro/register
# 用途: A股行情数据获取
TUSHARE_TOKEN=your_tushare_token_here

# ==================== AI 服务配置（按需选择） ====================

# --- DeepSeek（推荐，默认） ---
# 获取地址: https://platform.deepseek.com/api_keys
# 用途: AI 智能分析（分析师 + 决策者）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 硅基流动（备选） ---
# 获取地址: https://cloud.siliconflow.cn/account/ak
# 用途: 通过硅基流动调用 DeepSeek/Qwen 等模型
# SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ==================== 可选配置 ====================

# 数据库连接字符串 (默认: sqlite:///./chan.db)
# DATABASE_URL=sqlite:///./chan.db

# JWT 密钥 (默认: chanalyzer-secret-key-change-in-production)
# 生产环境建议修改为随机字符串
# JWT_SECRET_KEY=your-random-secret-key

# 最大并发扫描数 (默认: 5)
# MAX_CONCURRENT_SCANS=5

# 普通用户每日 AI 分析次数上限 (默认: 5, admin 不限量)
# AI_DAILY_LIMIT=5

# 新用户注册时给管理员发审核提醒邮件 (需配置 ADMIN_EMAIL)
# REGISTER_NOTIFY_EMAIL=true

# 服务端口 (默认: 8000)
# PORT=8000

# ==================== 邮件配置 (验证码/注册通知) ====================
# 阿里云邮件推送 DirectMail 或其他支持 SSL 的 SMTP 服务
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your_smtp_password
SMTP_FROM_NAME=缠论分析

# ==================== 云平台配置 (自动检测) ====================
# RENDER=true
# RAILWAY=true
